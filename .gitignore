# pyenv
#   For a library or package, you might want to ignore these files since the user is
#   responsible for setting up their own environment.
# .python-version

# pipenv
#   According to pypa/pipenv#1255, pipenv should generally play well with
#   git. However, if you're writing a library, you should ignore Pipfile.lock.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock should be ignored in a library context.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock should be ignored in a library context.
# pdm.lock

